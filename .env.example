# Копирај во Vercel → Project → Settings → Environment Variables (Production + Preview)

# Postgres connection string. Vercel → Storage → Create Database → Postgres (Neon)
# ја додава оваа варијабла автоматски (како POSTGRES_URL / DATABASE_URL).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Лозинка за контролниот панел (kikocredit.com/#admin). Избери долга лозинка.
ADMIN_PASSWORD=смени-ме
